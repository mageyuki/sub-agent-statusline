{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.test.ts", "test/**/*.ts", "vitest.config.ts", "vitest.package.config.ts"],
  "exclude": ["node_modules", "dist"]
}
